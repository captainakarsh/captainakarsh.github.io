# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# --- AI assistant (/api/chat) ---------------------------------------------
# Required for the "Ask AI" chat. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional model override (defaults to deepseek-chat, the low-cost model)
CHAT_MODEL=

# --- Contact form (/api/contact) — configure at least one ------------------
# Email delivery via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=akarshsingh2904@gmail.com
# Must be a sender on a domain verified in Resend; the default only works for testing.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# And/or a Discord or Slack incoming-webhook URL
CONTACT_WEBHOOK_URL=

# --- CORS -------------------------------------------------------------------
# Extra origins allowed to call the API (comma-separated).
# https://captainakarsh.github.io and http://localhost:3000 are always allowed.
ALLOWED_ORIGINS=

# --- Public (baked into the frontend at build time) -------------------------
NEXT_PUBLIC_SITE_URL=https://captainakarsh.github.io
# Leave empty on Vercel (same origin). The GitHub Pages build sets this to the Vercel URL.
NEXT_PUBLIC_API_BASE_URL=
